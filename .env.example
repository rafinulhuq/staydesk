# Copy to .env to override the local defaults. .env is git-ignored.
# The defaults only protect a local development database. Never reuse them anywhere else.

POSTGRES_DB=staydesk
POSTGRES_USER=staydesk
POSTGRES_PASSWORD=staydesk_dev
POSTGRES_PORT=5432

API_PORT=8080

# Demo account passwords. Public by design (listed in the README); override on the deployed demo.
SEED_ADMIN_PASSWORD=Admin123
SEED_STAFF_PASSWORD=Staff123
SEED_GUEST_PASSWORD=Guest123

# JWT signing key, at least 32 bytes. The default is for the local stack only; the deployed
# demo sets its own. For dotnet run: dotnet user-secrets set Jwt:SigningKey "<value>" --project src/StayDesk.Api
JWT_SIGNING_KEY=local-dev-only-signing-key-change-me-0123456789

# Read by the API (ASP.NET Core maps __ to :). For local runs, prefer:
#   dotnet user-secrets set ConnectionStrings:Default "<value>" --project src/StayDesk.Api
ConnectionStrings__Default=Host=localhost;Port=5432;Database=staydesk;Username=staydesk;Password=staydesk_dev
